# ─────────────────────────────────────────────────────────────
#  Bibi — configuration
#  Copie ce fichier en « .env » (cp .env.example .env) puis remplis-le.
#  Le fichier .env n'est JAMAIS versionné ni envoyé au navigateur.
#  Rien n'est obligatoire pour essayer Bibi en local.
#  Important : écris les commentaires sur leur PROPRE ligne (comme ici),
#  jamais après une valeur.
# ─────────────────────────────────────────────────────────────

# ── Serveur ──
# development | test | production
NODE_ENV=development
PORT=3000
# 127.0.0.1 = seulement cet ordinateur ; 0.0.0.0 = aussi les autres appareils du réseau
HOST=0.0.0.0

# ── Sécurité d'accès ──
# Une longue phrase aléatoire, 32 caractères minimum (obligatoire en production).
# Pour en fabriquer une : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Code d'accès unique (mode « une seule personne »). Recommandé dès que Bibi est sur Internet.
BIBI_ACCESS_CODE=
# true = ouvre Bibi à TOUT LE MONDE sans code. Déconseillé : tes clés d'IA seraient utilisables par n'importe qui.
BIBI_ALLOW_OPEN=false
# true = comptes e-mail + mot de passe, et synchronisation entre appareils.
ENABLE_CLOUD_SYNC=false
# true = n'importe qui peut créer un compte (à éviter hors test). Le premier compte est toujours permis.
ALLOW_REGISTRATION=false
# Seulement si l'interface est servie depuis un AUTRE domaine que le serveur (ex. https://bibi.exemple.fr)
CORS_ORIGIN=
RATE_LIMIT_PER_MINUTE=120

# ── Fournisseurs d'IA (chaque clé est facultative ; il en faut au moins une pour discuter) ──
# gemini | groq | openrouter | custom
AI_DEFAULT_PROVIDER=gemini
# Niveau gratuit limité : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Niveau gratuit limité : https://console.groq.com/keys
GROQ_API_KEY=
# Modèles gratuits « :free » et payants : https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Règle de dépense : tant que c'est « false », Bibi REFUSE tout modèle ou moteur payant, même si tu as une clé.
ALLOW_PAID_PROVIDERS=false

# Fournisseur supplémentaire compatible OpenAI (Ollama, LM Studio, vLLM, Together…)
CUSTOM_AI_NAME=Fournisseur personnalisé
# Exemple : http://localhost:11434/v1
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
# Noms de modèles séparés par des virgules. Exemple : llama3.2,qwen2.5
CUSTOM_AI_MODELS=
# true seulement si tu es SÛR que ce fournisseur ne coûte rien (ex. un service qui tourne chez toi)
CUSTOM_AI_FREE=false

# ── Voix (facultatif) ──
# ElevenLabs : gratuit jusqu'à un petit quota puis payant → bloqué tant que ALLOW_PAID_PROVIDERS=false
ELEVENLABS_API_KEY=
# Serveur Piper que TU héberges. Exemple : http://localhost:5000
PIPER_URL=
# Voix Piper proposées, séparées par des virgules. Exemple : fr_FR-siwis-medium,fr_FR-upmc-medium
PIPER_VOICES=
# Serveur Kokoro que TU héberges. Exemple : http://localhost:8880/v1
KOKORO_URL=

# ── Données ──
# Dossier de la base SQLite : à sauvegarder !
DATA_DIR=data
# Vide = <DATA_DIR>/bibi.db. Sinon : sqlite:/chemin/vers/bibi.db
DATABASE_URL=
# false = « Ma mémoire avec Bibi » est coupée pour tout le monde sur ce serveur
ENABLE_LOCAL_MEMORY=true
