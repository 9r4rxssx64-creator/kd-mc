tools/video/frames/
tools/video/output/_palette.png
tools/video/assets/*.png

# v13.4.225 — dist/ racine = build artifacts non versionnés
/dist/

# Worktrees éphémères des sub-agents Claude Code (copies internes du repo, jamais versionnées)
.claude/worktrees/

# Rapports d'audit générés localement (préfixe _ = output, pas source)
tests/_audit-*.txt
tests/_audit-*.json

# SEO skill — venv (recreated locally) + local Google API config (never commit keys)
.claude/skills/seo/.venv/
.claude/skills/**/.venv/
google-api.json

# Python cache
__pycache__/
*.pyc

# Copie de secours du domaine : fabriquée par prepare-secours.mjs, jamais commitée
services/kdmc-router/public/
services/kdmc-router/pages-upload/
audit/captures-paquet/
audit/captures-commerce/
services/kdmc-router/app-*/

# curseur de rotation du rappel (etat local a chaque session, pas a partager)
pipeline/rappel-etat.json

# dossiers patrimoine : donnees personnelles de la famille, JAMAIS publiees
# (le depot entier est servi publiquement par Cloudflare Pages)
