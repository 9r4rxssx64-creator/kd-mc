# resultats des recherches Ciclade : donnees personnelles, artefact CI seulement
/patrimoine-resultats/
mobile/build/
tools/pub/out/
audit/captures-commerce/
# Même raison que les deux dossiers ci-dessus : cette capture est REFAITE sur la
# vraie page à chaque passage du contrôle, et deux captures d'une page vivante ne
# sont jamais identiques à l'octet près. Suivie dans git, elle salissait l'arbre de
# travail de TOUTES les sessions à chaque lancement de la chaîne (22.09.2026).
# Elle reste produite et lisible à la demande — c'est son suivi qui est inutile.
audit/captures-perimetre/
# Idem : capture des tuiles de l'admin, refaite à chaque contrôle (24.09.2026).
audit/captures-admin/
audit/captures-vente/

# Paquet de reprise (fabrique par npm run transfert — copie locale, pas a versionner)
/transfert/
/transfert-kdmc-*.tgz

# Captures de la vérification « affichage sur ordinateur » (regénérées à la demande)
audit/arbre-ordi/
audit/arbre-visuel/

# Capture produite par tests/verify-tor-page.mjs (sortie de test, jamais un livrable)
tor-iphone.png
