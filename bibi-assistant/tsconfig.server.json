{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "outDir": "dist-server", "rootDir": ".", "strict": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "skipLibCheck": true, "esModuleInterop": true,
    "types": ["node"], "declaration": false, "sourceMap": false
  },
  "include": ["server"],
  "exclude": ["server/**/*.test.ts"]
}
